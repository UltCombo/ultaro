#!/bin/bash

#       Ultaro
# Ult's Manjaro setup

set -euxo pipefail
cd "$(dirname "${BASH_SOURCE[0]}")"

if [ "$(id -u)" -eq 0 ]; then
  echo 'This script cannot be run as root.'
  exit 1
fi

. util/remove_packages.sh

grep -qF 'ILoveCandy' /etc/pacman.conf || sudo sed -i'' '/# Misc options/a ILoveCandy' /etc/pacman.conf
sudo pacman -Syu --noconfirm
KEEP_PACKAGES="gnome-keyring" remove_packages tlp manjaro-hello manjaro-gdm-theme manjaro-gnome-settings manjaro-gnome-assets gnome gnome-extra evince mutter mutter-devkit nautilus-admin nautilus-empty-file gnome-screenshot gthumb totem caffeine-ng mntray
sudo pacman -S --needed --noconfirm base-devel nvm yay aws-cli git fish docker docker-compose xorg-xinput xorg-xprop xorg-xev xorg-xwininfo xorg-xkill xclip xdotool flameshot breeze breeze-icons ttf-fira-code noto-fonts-emoji vivaldi vivaldi-ffmpeg-codecs dolphin ark baloo libappindicator snixembed openresolv network-manager-applet blueman brightnessctl playerctl power-profiles-daemon lightdm lightdm-gtk-greeter i3-wm perl-anyevent-i3 i3status xss-lock dmenu feh dex dunst picom numlockx gnome-keyring polkit-gnome lxappearance thermald python-websocket-client python-requests
yay -S --needed --noconfirm i3lock-color rxvt-unicode-truecolor-wide-glyphs visual-studio-code-bin stacer nomacs slack-desktop
yay -Yc --noconfirm
yes | yay -Scc || true

# Set up configs, desktop files and default applications.
sudo cp -rlf root/. /
sudo ln -f browser_launcher/bin/* /usr/bin/
cp -rlf home/. ~/
nomacs --import-settings nomacs/nomacs.ini

sudo systemctl enable --now thermald

# Set up DNS.
sudo resolvconf -u

# Set up Docker.
sudo gpasswd -a "$(whoami)" docker

# Set up fish.
chsh -s /usr/bin/fish

# Set up nvm.
sudo chown -R "$(whoami)" /usr/share/nvm
grep -qF 'init-nvm.sh' ~/.bashrc || echo 'source /usr/share/nvm/init-nvm.sh' >> ~/.bashrc
fish --command 'nvm install 26'

# Set up desktop.
timedatectl set-ntp 1
gsettings set org.gnome.desktop.interface color-scheme 'prefer-dark'
gsettings set org.gnome.desktop.interface gtk-theme 'Breeze-Dark'
gsettings set org.gnome.desktop.interface icon-theme 'breeze-dark'
gsettings set org.gnome.desktop.interface cursor-theme 'Adwaita'
gsettings set org.gnome.desktop.privacy remember-recent-files false
gsettings set org.gnome.desktop.privacy recent-files-max-age 0
mkdir -p "$HOME/Pictures/Screenshots"

# Don't suspend when lid is closed.
sudo sed -i'' -E 's/.*(HandleLidSwitch=).*/\1ignore/' /etc/systemd/logind.conf

# Set up LightDM autologin.
grep -qE '^autologin-user=' /etc/lightdm/lightdm.conf || sudo sed -i'' -E '/^\[Seat:\*\]/a autologin-user='"$(whoami)"$'\\\nautologin-user-timeout=0\\\nautologin-session=i3' /etc/lightdm/lightdm.conf
sudo systemctl disable gdm || true
sudo systemctl enable lightdm

# Set up system.
echo 'vm.max_map_count=262144' | sudo tee /etc/sysctl.d/11-ultaro.conf
sudo sysctl --system

# Set up startup applications and services.
flameshot config --autostart true
sudo systemctl mask --now man-db.timer pamac-daemon.service

# Clean up.
rm -f ~/Readme ~/Templates/* ~/.config/autostart/create-template.desktop ~/.config/autostart/manjaro-tiling-settings.desktop

echo '✨ Setup finished successfully.'
